# Base model: the official ResembleAI checkpoint is required and is not bundled.
BASE_MODEL_REPO=ResembleAI/chatterbox-turbo
BASE_MODEL_REVISION=main
BASE_MODEL_DIR=

# Spanish Lucía fine-tunes. Leave SPANISH_MODEL_DIR empty for automatic HF download.
SPANISH_ENABLED=1
SPANISH_MODEL_REPO=groxaxo/chaturbo-espanol
SPANISH_MODEL_REVISION=main
SPANISH_MODEL_DIR=
DEFAULT_SPANISH_PROFILE=lucia-ar

# Number of Spanish T3 variants retained per worker. English remains loaded separately.
SPANISH_PROFILE_CACHE_SIZE=1

# Optional eager loading, e.g. lucia-ar or lucia-ar,lucia-latam.
# Increase SPANISH_PROFILE_CACHE_SIZE when preloading more than one Spanish profile.
PRELOAD_PROFILES=
STRICT_SPANISH_TAGS=1

# Verify adapter and AR warm-start hashes when adapter_provenance.json is present.
VERIFY_MODEL_PROVENANCE=1

# Exact-output Chatterbox Turbo hot-path optimizations. Source-sensitive rewrites
# apply only when package/version/source guards match chatterbox-tts 0.1.6.
TURBO_PERFORMANCE_RUNTIME=1
TURBO_EXPECTED_CHATTERBOX_VERSION=0.1.6
TURBO_FAIL_ON_INCOMPATIBLE_PACKAGE=0
TURBO_CACHE_ENCODED_CONDITIONING=1
TURBO_PREALLOCATE_TOKEN_IDS=1
TURBO_CACHE_SILENCE_TENSOR=1
TURBO_DISABLE_PROGRESS=1
TURBO_STRICT_LOGIT_CHECKS=1
TURBO_REWRITE_PACKAGE_GENERATE=1

# Keep the model resident for 30 minutes after use. Set 0 to disable idle eviction.
MODEL_IDLE_UNLOAD_SECONDS=1800

# Optional persona overrides. Normally use the conditioning.pt/reference.wav from HF.
LUCIA_REFERENCE_WAV=
LUCIA_CONDITIONING_PT=

# Authentication for private/gated Hugging Face repositories, when required.
HF_TOKEN=
